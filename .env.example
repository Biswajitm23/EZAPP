# Copy this file to `.env` and fill in your values.
# In production builds these are read from app.json -> expo.extra (see config/index.ts).

# Base URL of the Employee Zone API (note the trailing slash)
EXPO_PUBLIC_BASE_URL=https://bitpastel.org/employee-zone/api

# Google OAuth (the existing Employee Zone portal uses Google sign-in)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
